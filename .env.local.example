# ─── Supabase (required for Phase 0+) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Anthropic (required for Phase 1+ — notes AI summaries, weekly digest) ───
ANTHROPIC_API_KEY=

# ─── Stripe (required for Phase 2+ — card capture, payments, subscription) ───
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Twilio (required for Phase 2+ — SMS reminders) ──────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Resend (active now — waitlist emails + future transactional) ─────────────
RESEND_API_KEY=
WAITLIST_NOTIFICATION_EMAIL=anil.vijay@gmail.com

# ─── Cron secret (used by /api/reminders and /api/digest to verify Vercel cron)
CRON_SECRET=

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Practice OS
